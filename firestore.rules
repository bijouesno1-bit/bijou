rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role == 'admin' && me().active == true;
    }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role in ['admin','agent'] && me().active == true;
    }
    function validRequest() {
      let d = request.resource.data;
      let tt = get(/databases/$(database)/documents/ticketTypes/$(d.ticketTypeId)).data;
      let pay = get(/databases/$(database)/documents/settings/payment).data;
      return exists(/databases/$(database)/documents/settings/payment)
        && pay.get('organizerWa', '') is string
        && pay.get('organizerWa', '').size() >= 8
        && d.keys().hasOnly(['eventId','ticketTypeId','ticketName','unitPrice','quantity','total','customerName','phone','email','paymentMethod','comment','status','createdAt'])
        && d.keys().hasAll(['eventId','ticketTypeId','ticketName','unitPrice','quantity','total','customerName','phone','paymentMethod','status','createdAt'])
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 80
        && d.phone is string && d.phone.size() >= 6 && d.phone.size() <= 20
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
        && d.paymentMethod in pay.get('methods', ['cash','virement','airtel','moov','autre'])
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 10
        && tt.active == true
        && tt.get('kind', '') != 'invitation'
        && d.eventId == tt.eventId
        && get(/databases/$(database)/documents/events/$(tt.eventId)).data.status == 'published'
        && d.unitPrice == tt.price
        && d.total == tt.price * d.quantity
        && d.quantity <= tt.quantity - tt.sold - tt.get('reserved', 0);
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.role == 'agent'
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['role','active','email','name','createdAt','createdBy'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && resource.data.role == 'agent'
        && request.resource.data.role == 'agent'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if false;
    }
    match /events/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /ticketTypes/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /requests/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validRequest();
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /tickets/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isStaff()
        && resource.data.status == 'valid'
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt','usedBy']));
      allow delete: if false;
    }
    match /batches/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /venues/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','kind','description','hours','phone','email','mapUrl','lat','lng','active','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.kind in ['vente','distribution']
        && request.resource.data.description.size() <= 300
        && request.resource.data.hours.size() <= 120
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email.size() <= 100
        && request.resource.data.mapUrl.size() <= 300
        && (request.resource.data.mapUrl == '' || request.resource.data.mapUrl.matches('https://.*'))
        && (request.resource.data.lat == null || request.resource.data.lat is number)
        && (request.resource.data.lng == null || request.resource.data.lng is number)
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /checkpoints/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /scans/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.result in ['ok','used','bad','unknown']
        && request.resource.data.ticketId is string
        && request.resource.data.ticketId.size() <= 200
        && request.resource.data.keys().hasOnly(['ticketId','result','by','at','checkpoint','checkpointId','eventId','ticketTypeId','ticketName','free'])
        && (!('eventId' in request.resource.data) || (request.resource.data.eventId is string && request.resource.data.eventId.size() <= 100))
        && (!('ticketTypeId' in request.resource.data) || (request.resource.data.ticketTypeId is string && request.resource.data.ticketTypeId.size() <= 100))
        && (!('ticketName' in request.resource.data) || (request.resource.data.ticketName is string && request.resource.data.ticketName.size() <= 200))
        && (!('free' in request.resource.data) || request.resource.data.free is bool);
      allow update, delete: if false;
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
