rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role == 'admin' && me().active == true;
    }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role in ['admin','agent'] && me().active == true;
    }
    function isOrganizer() {
        return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && me().role == 'organizer' && me().active == true;
      }
      function validRequest() {
      let d = request.resource.data;
      let tt = get(/databases/$(database)/documents/ticketTypes/$(d.ticketTypeId)).data;
      let ownerId = d.get('ownerId', '');
      let pay = ownerId == '' ? get(/databases/$(database)/documents/settings/payment).data : get(/databases/$(database)/documents/orgPayment/$(ownerId)).data;
      return (ownerId == '' ? exists(/databases/$(database)/documents/settings/payment) : exists(/databases/$(database)/documents/orgPayment/$(ownerId)))
        && pay.get('organizerWa', '') is string
        && pay.get('organizerWa', '').size() >= 8
        && d.keys().hasOnly(['eventId','ticketTypeId','ticketName','unitPrice','quantity','total','customerName','phone','email','paymentMethod','comment','status','createdAt','ownerId'])
        && d.keys().hasAll(['eventId','ticketTypeId','ticketName','unitPrice','quantity','total','customerName','phone','paymentMethod','status','createdAt'])
        && d.status == 'pending'
        && get(/databases/$(database)/documents/events/$(tt.eventId)).data.get('ownerId', '') == ownerId
        && d.createdAt == request.time
        && d.customerName is string && d.customerName.size() >= 2 && d.customerName.size() <= 80
        && d.phone is string && d.phone.size() >= 6 && d.phone.size() <= 20
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
        && d.paymentMethod in pay.get('methods', ['cash','virement','airtel','moov','autre'])
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 10
        && tt.active == true
        && tt.get('kind', '') != 'invitation'
        && d.eventId == tt.eventId
        && get(/databases/$(database)/documents/events/$(tt.eventId)).data.status == 'published'
        && d.unitPrice == tt.price
        && d.total == tt.price * d.quantity
        && d.quantity <= tt.quantity - tt.sold - tt.get('reserved', 0);
    }
    match /users/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.role == 'organizer'
          && request.resource.data.active == true
          && request.resource.data.keys().hasOnly(['role','active','email','name','category','phone','createdAt'])
          && request.resource.data.category in ['particulier','etablissement','entreprise']
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
          && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin()
        || (isOrganizer() && resource.data.get('ownerId', '') == request.auth.uid));
      allow create: if isAdmin()
        && request.resource.data.role == 'agent'
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['role','active','email','name','createdAt','createdBy'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && resource.data.role == 'agent'
        && request.resource.data.role == 'agent'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl'])
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() < 300
        && (request.resource.data.photoUrl == '' || request.resource.data.photoUrl.matches('https://res[.]cloudinary[.]com/aj0kawm2/.*'));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl'])
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() < 300
        && (request.resource.data.photoUrl == '' || request.resource.data.photoUrl.matches('https://res[.]cloudinary[.]com/aj0kawm2/.*'));
      allow create: if isOrganizer()
        && request.resource.data.role == 'agent'
        && request.resource.data.active == true
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.eventId is string;
      allow update: if isOrganizer()
        && resource.data.role == 'agent'
        && resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.role == 'agent'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','gateIds','name','phone']);
      allow delete: if (isAdmin() || (isOrganizer() && resource.data.get('ownerId', '') == request.auth.uid))
        && resource.data.role == 'agent';
    }
    match /events/{id} {
      allow get: if signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().role == 'agent' && me().get('eventId', '') == id;
        allow read: if resource.data.status == 'published' || isAdmin()
          || (signedIn() && resource.data.ownerId == request.auth.uid);
        allow create: if isAdmin() || (isOrganizer()
          && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'published'
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.category == 'particulier'))
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['title','date','venue','city','description','status','ownerId','ownerName','category','businessName','logo','contactPhone','contactEmail','lat','lng','maxCapacity','poster','photos','createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 120
          && request.resource.data.description.size() <= 1000
          && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 6)));
        allow update: if isAdmin() || (isOrganizer()
          && resource.data.get('ownerId', '') == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','date','venue','city','description','contactPhone','contactEmail','lat','lng','maxCapacity','poster','photos','logo','businessName','status','hiddenFrom'])
          && request.resource.data.title is string && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 120
          && request.resource.data.get('description', '').size() <= 1000
          && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 6))
          && (
            (request.resource.data.status == resource.data.status
              && request.resource.data.get('hiddenFrom', '') == resource.data.get('hiddenFrom', ''))
            || (resource.data.status == 'published' && request.resource.data.status == 'hidden'
              && request.resource.data.get('hiddenFrom', '') == 'owner')
            || (resource.data.status == 'hidden' && resource.data.get('hiddenFrom', '') == 'owner'
              && request.resource.data.status == 'published')
          ));
        allow delete: if isAdmin() || (isOrganizer()
          && resource.data.get('ownerId', '') == request.auth.uid
          && (resource.data.status in ['pending','refused']
            || (resource.data.status == 'hidden' && resource.data.get('hiddenFrom', '') == 'owner')));
      }
    match /ticketTypes/{id} {
      allow update: if isOrganizer()
        && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.get('ownerId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold','reserved'])
        && request.resource.data.sold >= resource.data.sold;
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /requests/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validRequest();
      allow update: if resource.data.status == 'pending'
        && resource.data.get('waSent', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waSent','waSentAt'])
        && request.resource.data.waSent == true
        && request.resource.data.waSentAt == request.time;
      allow update: if isOrganizer()
        && resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paymentStatus','paymentRef','ticketTokens','paidAt','paidBy','adminNote','decidedAt'])
        && (request.resource.data.get('paymentStatus', '') != 'confirmed'
            || resource.data.get('waSent', false) == true
            || resource.data.status == 'approved');
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /tickets/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow list: if isStaff() && resource.data.issuedBy == request.auth.uid;
      allow list: if isOrganizer() && resource.data.ownerId == request.auth.uid;
      allow list: if isOrganizer() && get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.get('ownerId', '') == request.auth.uid;
      allow list: if isStaff() && resource.data.gateId in me().get('gateIds', []);
      allow create: if isAdmin();
      allow create: if isStaff()
        && me().role == 'agent'
        && me().get('ownerId', '') != ''
        && request.resource.data.keys().hasOnly(['requestId','eventId','ticketTypeId','eventTitle','eventDate','venue','city','ticketName','holderName','seq','count','price','persons','zone','validUntil','status','createdAt','issuedBy','gateId','ownerId','issuedOffline','issuedAt'])
        && request.resource.data.issuedBy == request.auth.uid
        && request.resource.data.ownerId == me().ownerId
        && request.resource.data.eventId == me().get('eventId', '')
        && request.resource.data.gateId in me().get('gateIds', [])
        && request.resource.data.status == 'valid'
        && request.resource.data.price is number
        && request.resource.data.createdAt == request.time
        && request.resource.data.issuedAt == request.time
        && token.size() >= 20
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/allocations/$(request.resource.data.eventId + '_' + request.auth.uid + '_' + request.resource.data.ticketTypeId)).data.qty > 0;
      allow update: if isAdmin() || (isStaff()
        && resource.data.status == 'valid'
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt','usedBy']));
      allow create: if isOrganizer()
        && request.resource.data.keys().hasOnly(['requestId','eventId','ticketTypeId','eventTitle','eventDate','venue','city','ticketName','holderName','seq','count','price','persons','zone','validUntil','kind','status','createdAt'])
        && request.resource.data.status == 'valid'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.get('ownerId', '') == request.auth.uid
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.eventId == request.resource.data.eventId
        && (get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.get('waSent', false) == true
            || get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.status == 'approved');
      allow delete: if isAdmin();
    }
    match /batches/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /venues/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','kind','description','hours','phone','email','mapUrl','lat','lng','active','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.kind in ['vente','distribution']
        && request.resource.data.description.size() <= 300
        && request.resource.data.hours.size() <= 120
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email.size() <= 100
        && request.resource.data.mapUrl.size() <= 300
        && (request.resource.data.mapUrl == '' || request.resource.data.mapUrl.matches('https://.*'))
        && (request.resource.data.lat == null || request.resource.data.lat is number)
        && (request.resource.data.lng == null || request.resource.data.lng is number)
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }
    match /orgPayment/{uid} {
      allow get: if true;
      allow write: if signedIn() && request.auth.uid == uid && (isOrganizer() || isAdmin());
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /checkpoints/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /scans/{id} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.result in ['ok','used','bad','unknown']
        && request.resource.data.ticketId is string
        && request.resource.data.ticketId.size() <= 200
        && request.resource.data.keys().hasOnly(['ticketId','result','by','at','checkpoint','checkpointId','eventId','ticketTypeId','ticketName','free'])
        && (!('eventId' in request.resource.data) || (request.resource.data.eventId is string && request.resource.data.eventId.size() <= 100))
        && (!('ticketTypeId' in request.resource.data) || (request.resource.data.ticketTypeId is string && request.resource.data.ticketTypeId.size() <= 100))
        && (!('ticketName' in request.resource.data) || (request.resource.data.ticketName is string && request.resource.data.ticketName.size() <= 200))
        && (!('free' in request.resource.data) || request.resource.data.free is bool);
      allow update, delete: if false;
    }
    match /gates/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isOrganizer() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (isOrganizer() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || (isOrganizer() && resource.data.ownerId == request.auth.uid);
    }
    match /allocations/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid || resource.data.agentId == request.auth.uid);
      allow create: if isAdmin() || (isOrganizer() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (isOrganizer() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || (isOrganizer() && resource.data.ownerId == request.auth.uid);
    }
    match /agentLogins/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin() || isOrganizer();
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid;
      allow create: if (isOrganizer() || isStaff()) && request.resource.data.by == request.auth.uid
        && request.resource.data.action == 'ticket_reprint'
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
